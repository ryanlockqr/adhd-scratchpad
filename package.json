{
  "name": "scratchpad",
  "displayName": "Scratchpad",
  "description": "Dump stray thoughts as you work in Cursor. You maintain the dump; the agent keeps the current task. Per-project rules git ignores.",
  "version": "0.1.0",
  "publisher": "ryanlockqr",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f20",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryanlockqr/adhd-scratchpad.git"
  },
  "bugs": {
    "url": "https://github.com/ryanlockqr/adhd-scratchpad/issues"
  },
  "homepage": "https://github.com/ryanlockqr/adhd-scratchpad#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "scratchpad",
    "inbox",
    "cursor",
    "rules",
    "capture",
    "focus"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scratchpad",
          "title": "Scratchpad",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "scratchpad": [
        {
          "type": "webview",
          "id": "scratchpad.sidebar",
          "name": "Scratchpad",
          "contextualTitle": "Scratchpad"
        }
      ]
    },
    "commands": [
      {
        "command": "scratchpad.quickDump",
        "title": "Quick Dump Thought",
        "category": "Scratchpad"
      },
      {
        "command": "scratchpad.clearDump",
        "title": "Clear Dump",
        "category": "Scratchpad"
      },
      {
        "command": "scratchpad.focusSidebar",
        "title": "Focus Sidebar",
        "category": "Scratchpad"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Scratchpad writes markdown rule files into the workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Scratchpad requires a local filesystem to sync agent rule files."
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -p ./ -watch",
    "lint": "tsc --noEmit -p ./",
    "icon": "python3 scripts/generate-icon.py",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^0.10.5",
    "typescript": "^5.7.2"
  }
}
